// secrets.h.example — template for include/secrets.h
//
// Copy this file to include/secrets.h and fill in your values.
// include/secrets.h is git-ignored and must never be committed.
// The file is optional: without it the firmware builds with defaults and
// everything is set up in the Web UI.
// Values are used while no stored setting exists (first boot, after a
// settings reset); stored settings take precedence (see
// docs/CONFIGURATION.md). Empty string or missing key = "not set".
// A value that violates its limits is skipped with an error log naming the
// key (never the value); the default applies.
//
// Status per key: "used" keys are read by the firmware today; "planned" keys
// are not read yet, their names may still change.

#pragma once

// ---- WiFi (station) --------------------------------------------------------
// Used. One network. SSID up to 32 bytes; empty = no network (setup AP).
// Password: empty (open network), 8..63 printable ASCII characters or
// exactly 64 hexadecimal characters.
// Renamed from SECRET_WIFI_SSID_1 / SECRET_WIFI_PASSWORD_1; the old names
// stop the build with a message.
#define SECRET_WIFI_SSID        ""
#define SECRET_WIFI_PASSWORD    ""

// ---- Setup access point ----------------------------------------------------
// Used. Empty = open AP; otherwise 8..63 printable ASCII characters (WPA2).
#define SECRET_AP_PASSWORD      ""

// Used. mDNS hostname (http://<name>.local): 1..63 letters, digits or
// hyphens, no leading/trailing hyphen. Empty = default "fussball" from
// app_config.h. Changeable later in the Web UI.
#define SECRET_HOSTNAME         ""

// ---- Web UI ----------------------------------------------------------------
// Planned. Optional admin password for settings and OTA. Empty = no
// password.
#define SECRET_ADMIN_PASSWORD   ""

// ---- Data providers --------------------------------------------------------
// Planned. Default provider id: "openligadb" (free, no key). Others are
// planned.
#define SECRET_DEFAULT_PROVIDER     "openligadb"
#define SECRET_API_FOOTBALL_KEY     ""
#define SECRET_FOOTBALL_DATA_KEY    ""

// ---- Personal presets ------------------------------------------------------
// Planned. Club and competition as ids of the default provider
// (OpenLigaDB: competition shortcut, e.g. "bl1", and teamId).
#define SECRET_DEFAULT_COMPETITION  ""
#define SECRET_DEFAULT_TEAM_ID      ""

// Planned. Time zone as POSIX TZ string (ESP-IDF uses POSIX TZ, not IANA
// names). Default Europe/Berlin.
#define SECRET_TIMEZONE             "CET-1CEST,M3.5.0,M10.5.0/3"
