// secrets.h.example — template for include/secrets.h
//
// Copy this file to include/secrets.h and fill in your values.
// include/secrets.h is git-ignored and must never be committed.
// The file is optional: without it the firmware builds with defaults and
// everything is set up in the Web UI.
// Values are used on first boot and after a factory reset; settings changed
// in the Web UI take precedence afterwards (see docs/CONFIGURATION.md).
// Empty string = "not set".
//
// DRAFT: keys and names are finalised with the settings model.

#pragma once

// ---- WiFi (station) --------------------------------------------------------
// One network. Empty SSID = no credentials → setup AP.
#define SECRET_WIFI_SSID_1      ""
#define SECRET_WIFI_PASSWORD_1  ""

// ---- Setup access point ----------------------------------------------------
// Optional. Empty = open AP. WPA2 requires at least 8 characters.
#define SECRET_AP_PASSWORD      ""

// mDNS hostname (http://<name>.local). Empty = default "fussball" from
// app_config.h. Changeable later in the Web UI.
#define SECRET_HOSTNAME         ""

// ---- Web UI ----------------------------------------------------------------
// Optional admin password for settings and OTA. Empty = no password.
#define SECRET_ADMIN_PASSWORD   ""

// ---- Data providers --------------------------------------------------------
// Default provider id: "openligadb" (free, no key). Others are planned.
#define SECRET_DEFAULT_PROVIDER     "openligadb"
#define SECRET_API_FOOTBALL_KEY     ""
#define SECRET_FOOTBALL_DATA_KEY    ""

// ---- Personal presets ------------------------------------------------------
// Club and competition as ids of the default provider
// (OpenLigaDB: competition shortcut, e.g. "bl1", and teamId).
#define SECRET_DEFAULT_COMPETITION  ""
#define SECRET_DEFAULT_TEAM_ID      ""

// Time zone as POSIX TZ string (ESP-IDF uses POSIX TZ, not IANA names).
// Default Europe/Berlin.
#define SECRET_TIMEZONE             "CET-1CEST,M3.5.0,M10.5.0/3"
