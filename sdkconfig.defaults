# Intentional settings shared by all targets. Board-dependent settings live in
# targets/<target>.sdkconfig.defaults (ADR-010); both are listed per env in
# platformio.ini.
# Generated sdkconfig.<env> files are build artefacts (git-ignored). The build
# regenerates them when a defaults file changes and stops if a setting below
# is missing from or differs in the generated file (scripts/sdkconfig_guard.py).

# -Os: smaller and usually fast enough; flash is the tight resource.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# A new OTA image must confirm itself after boot, otherwise the bootloader
# rolls back to the previous image (docs/NETWORK.md, OTA).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Task watchdog (5 s) restarts the device instead of only printing. The
# display supervision relies on it (docs/ARCHITECTURE.md, display failures).
# Set explicitly, not left to IDF defaults, so the build check covers them.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_PANIC=y


# All-task stack snapshots use raw status records, not CPU statistics or text
# formatting. A failed local heap-monitor allocation must return an error.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
# CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS is not set
# CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS is not set
# CONFIG_HEAP_ABORT_WHEN_ALLOCATION_FAILS is not set

# ---- LVGL 9.6 (trimmed config for the C6) ----
# Unlisted LVGL options keep their Kconfig defaults.

# LVGL's own heap for widgets, styles and texts: a static block in internal
# RAM (default 64 KB). 32 KB is enough for the planned screens; the boot log
# prints the real usage (display: "LVGL pool ..."); the final value follows
# once the real screens exist.
CONFIG_LV_MEM_SIZE=32768

# Pixel formats LVGL can draw. Kept: RGB565 (display and raw images, ADR-008),
# RGB565A8 (images with alpha), ARGB8888 (layers with transparency), A8
# (alpha masks). The others are not used and only cost flash.
# CONFIG_LV_DRAW_SW_SUPPORT_RGB565_SWAPPED is not set
CONFIG_LV_DRAW_SW_SUPPORT_RGB888=y
# CONFIG_LV_DRAW_SW_SUPPORT_XRGB8888 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_ARGB8888_PREMULTIPLIED is not set
# CONFIG_LV_DRAW_SW_SUPPORT_L8 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_AL88 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_I1 is not set

# Warnings and errors from LVGL (e.g. out of memory) on the console.
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_CUSTOM_TRANSPORT=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# A failed LVGL allocation logs file and line and stops; the task watchdog
# then restarts the device instead of LVGL running on with missing objects.
CONFIG_LV_USE_ASSERT_MALLOC=y

# Themes: only the default theme. Widgets: only what the screens need
# (label, image, line, arc); the default theme links every enabled widget.
# Enable further widgets when a screen needs them.
# CONFIG_LV_USE_THEME_SIMPLE is not set
# CONFIG_LV_USE_THEME_MONO is not set
# CONFIG_LV_USE_ANIMIMG is not set
# CONFIG_LV_USE_ARC is not set
# CONFIG_LV_USE_ARCLABEL is not set
# CONFIG_LV_USE_BAR is not set
# CONFIG_LV_USE_BUTTON is not set
# CONFIG_LV_USE_BUTTONMATRIX is not set
# CONFIG_LV_USE_CALENDAR is not set
# CONFIG_LV_USE_CANVAS is not set
# CONFIG_LV_USE_CHART is not set
# CONFIG_LV_USE_CHECKBOX is not set
# CONFIG_LV_USE_DROPDOWN is not set
# CONFIG_LV_USE_IMAGEBUTTON is not set
# CONFIG_LV_USE_KEYBOARD is not set
# CONFIG_LV_USE_LED is not set
# CONFIG_LV_USE_LIST is not set
# CONFIG_LV_USE_LINE is not set
# CONFIG_LV_USE_MENU is not set
# CONFIG_LV_USE_MSGBOX is not set
# CONFIG_LV_USE_ROLLER is not set
# CONFIG_LV_USE_SCALE is not set
# CONFIG_LV_USE_SLIDER is not set
# CONFIG_LV_USE_SPAN is not set
# CONFIG_LV_USE_SPINBOX is not set
# CONFIG_LV_USE_SPINNER is not set
# CONFIG_LV_USE_SWITCH is not set
# CONFIG_LV_USE_TEXTAREA is not set
# CONFIG_LV_USE_TABLE is not set
# CONFIG_LV_USE_TABVIEW is not set
# CONFIG_LV_USE_TILEVIEW is not set
# CONFIG_LV_USE_WIN is not set

# LVGL examples and demos are not part of the firmware (build time only).
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set

# Product JPEG rendering through the existing POSIX file adapter.
CONFIG_LV_USE_TJPGD=y
CONFIG_LV_USE_FS_POSIX=y
CONFIG_LV_FS_POSIX_LETTER=65
CONFIG_LV_FS_POSIX_PATH="/fs/"
# CONFIG_LV_FONT_MONTSERRAT_28 is not set
# CONFIG_LV_FONT_MONTSERRAT_18 is not set

# OTA metadata is the first custom descriptor after esp_app_desc.
# Incoming provider HTTPS is validated with the IDF certificate bundle.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
# CONFIG_MBEDTLS_TLS_SERVER_AND_CLIENT is not set
# CONFIG_MBEDTLS_TLS_SERVER_ONLY is not set
# CONFIG_MBEDTLS_SERVER_SSL_SESSION_TICKETS is not set
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=y
CONFIG_HTTPD_WS_SUPPORT=y
